# Supabase project credentials.
# Copy this file to `.env.local` and fill in your values.
#
# The app is LOCAL-FIRST: if these are left blank, Quotebook still runs fully
# in guest mode (all data lives in the browser via Dexie/IndexedDB). Supabase
# is only required for authentication, cross-device sync, and collaboration.

NEXT_PUBLIC_SUPABASE_URL=

# Supabase replaced the `anon` JWT with a *publishable* key (`sb_publishable_…`).
# Set the publishable key; it wins when both are present. The legacy anon key
# still works but is deprecated — see src/lib/supabase.ts.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Quick Add AI parsing (optional) ----------------------------------------
# Set to "true" only AFTER deploying the parse-capture Edge Function and
# setting a provider key (see README → Quick Add). Left unset, Quick Add still
# works: captures are saved instantly and converted from the Inbox by hand.
#
# The provider key itself is a SERVER secret and never belongs in this file:
#   supabase secrets set GEMINI_API_KEY=...
NEXT_PUBLIC_QUICKADD_AI=
